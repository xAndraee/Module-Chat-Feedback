{
  "schemaVersion": 1,
  "id": "autism-module-toggle-feedback",
  "version": "${version}",
  "name": "AUTISM Module Toggle Feedback",
  "description": "Adds a setting to control module enable and disable chat feedback.",
  "authors": [
    "xAndraee"
  ],
  "custom": {
    "autism:color": "255,190,80",
    "modmenu": {
      "parent": {
        "id": "autism"
      }
    }
  },
  "environment": "client",
  "entrypoints": {
    "client": [],
    "autism": [
      "autismclient.addon.moduletogglefeedback.ModuleToggleFeedbackAddon"
    ]
  },
  "mixins": [
    "autism-module-toggle-feedback.mixins.json"
  ],
  "depends": {
    "java": ">=25",
    "minecraft": "${mc_compat}",
    "fabricloader": ">=0.19.3",
    "fabric-api": ">=${fabric_api_version}",
    "autism": ">=${autism_api_version}"
  }
}
